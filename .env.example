OURDESKPET_API_KEY=sk-your-api-key-here
OURDESKPET_BASE_URL=https://api.openai.com/v1
OURDESKPET_MODEL=your-model-name

# Optional. Future settings UI can use this as a model switch list.
# Use the exact model names from your provider or proxy.
# OURDESKPET_MODEL_OPTIONS=openai/gpt-5.4,anthropic/claude-opus-4.7,google/gemini-3.1-pro-preview,deepseek/deepseek-v4-pro

# Optional. If omitted, the app reads prompts/rina_system_prompt.md.
# OURDESKPET_SYSTEM_PROMPT=You are OurDeskPet.
# OURDESKPET_PROMPT_FILE=E:\OurDeskPet\prompts\rina_system_prompt.md
