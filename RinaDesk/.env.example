OURDESKPET_API_KEY=sk-your-api-key-here
OURDESKPET_BASE_URL=https://api.openai.com/v1
OURDESKPET_MODEL=your-model-name

# DeepSeek official API uses the stable alias below for the latest V4.1 Flash snapshot.
# OURDESKPET_BASE_URL=https://api.deepseek.com
# OURDESKPET_MODEL=deepseek-flash

# Optional. Future settings UI can use this as a model switch list.
# Use the exact model names from your provider or proxy.
# OURDESKPET_MODEL_OPTIONS=deepseek-flash,deepseek-v4-pro

# Optional. If omitted, the app reads prompts/rina_system_prompt.md.
# OURDESKPET_SYSTEM_PROMPT=You are RinaDesk Agent.
# OURDESKPET_PROMPT_FILE=prompts/rina_system_prompt.md

# Official DeepSeek profiles use the same model API key for DeepSeek Search.
# Tavily is optional for other providers and serves as a fallback for DeepSeek.
# Automatic mode uses model tool calling. Maximum two logical searches per user turn.
# Context budget is characters, not exact tokens. Timeout bounds stalled reads and model rounds with no meaningful progress; heartbeats do not reset it.
TAVILY_API_KEY=
OURDESKPET_SEARCH_ENABLED=true
OURDESKPET_TAVILY_BASE_URL=https://api.tavily.com
OURDESKPET_CONTEXT_CHARS=12000
OURDESKPET_READ_TIMEOUT_SECS=180

# Chat settings (also editable in Settings > Chat).
OURDESKPET_HISTORY_KEEP=8
OURDESKPET_HISTORY_TRIGGER=12
OURDESKPET_SUMMARY_TARGET=300
OURDESKPET_SUMMARY_CAP=500
OURDESKPET_SEARCH_MODE=auto
# Project mode always has the bundled guide. Source reading is opt-in and read-only.
OURDESKPET_PROJECT_READ_ENABLED=false
OURDESKPET_PROJECT_SETTINGS_ENABLED=false
