{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OurDeskPet",
  "version": "0.1.0",
  "identifier": "com.bzgao.ourdeskpet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OurDeskPet",
        "width": 280,
        "height": 410,
        "minWidth": 200,
        "minHeight": 240,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "licenseFile": "installer/PREVIEW-LICENSE.txt",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "customLanguageFiles": {
          "SimpChinese": "installer/SimpChinese.nsh",
          "English": "installer/English.nsh"
        },
        "displayLanguageSelector": true,
        "sidebarImage": "installer/art/sidebar-rina.bmp",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "publisher": "bz-GAO",
    "homepage": "https://github.com/bz-GAO/OurDeskPet",
    "copyright": "@bz-GAO"
  },
  "mainBinaryName": "OurDeskPet"
}
