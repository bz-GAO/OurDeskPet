# Optional legacy/manual configuration. The desktop Settings page writes to the
# current user's local application-data directory instead of this repository.
# To configure by hand, copy this file to .env and fill DASHSCOPE_API_KEY.
# Never commit .env or paste its contents into an issue/chat.

# Qwen AI Platform / DashScope pay-as-you-go, OpenAI-compatible endpoint
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_HTTP_API_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_WEBSOCKET_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
DASHSCOPE_MIN_REQUEST_INTERVAL_SECONDS=1.1
